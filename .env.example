# Copier dans .env sur le VPS. Générer la clé avec : openssl rand -hex 32
SESSION_SECRET=
# IP Docker fixe de Traefik ou CIDR d’un réseau réservé aux proxys de confiance.
# Ne pas renseigner un réseau partagé avec des conteneurs non fiables.
TRUST_PROXY_CIDRS=
SESSION_GENERATIONS_PER_HOUR=5
IP_GENERATIONS_PER_HOUR=10
GLOBAL_GENERATIONS_PER_HOUR=30
RENDER_TIMEOUT_SECONDS=2700
EXPORT_RETENTION_HOURS=24
OUTPUT_MAX_MB=20480
MIN_FREE_DISK_MB=2048
RENDER_CACHE_MAX_MB=8192
APP_MEMORY_LIMIT=4g
APP_CPUS=2.0
